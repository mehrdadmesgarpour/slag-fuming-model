"% Fuming thermodynamic model: governing equations\n\n% Minimisation problem\n\\begin{equation}\n\\min_{n}\\; G(T,P,n)=\\sum_{i} n_i\\,\\mu_i \\qquad\\text{subject to}\\qquad \\sum_i a_{ij}\\,n_i=b_j\\;\\;(j=1,\\dots,E),\\qquad n_i\\ge 0\n\\end{equation}\n\\begin{equation}\n\\text{gas:}\\qquad \\frac{\\mu_i}{RT}=\\frac{g_i^\\circ(T)}{RT}+\\ln\\frac{n_i}{N_\\mathrm{g}}+\\ln\\frac{P}{P^\\circ}\n\\end{equation}\n\\begin{equation}\n\\text{slag:}\\qquad \\frac{\\mu_i}{RT}=\\frac{g_i^\\circ(T)}{RT}+\\ln\\gamma_i(T)+\\ln x_i,\\qquad x_i=\\frac{n_i}{N_\\mathrm{s}},\\qquad a_i=\\gamma_i\\,x_i\n\\end{equation}\n\\begin{equation}\n\\text{pure condensed phase:}\\qquad \\frac{\\mu_c}{RT}=\\frac{g_c^\\circ(T)}{RT}\n\\end{equation}\n\\begin{equation}\ng_i^\\circ(T)=h_i^\\circ(T)-T\\,s_i^\\circ(T)\n\\end{equation}\n\n% Conditions at the minimum\n\\begin{equation}\n\\frac{\\mu_i}{RT}=\\sum_j a_{ij}\\,\\pi_j \\quad\\text{for every species present},\\qquad \\pi_j=\\frac{\\lambda_j}{RT}\n\\end{equation}\n\\begin{equation}\n\\text{pure phase:}\\qquad a_c=\\exp\\!\\Big(\\sum_j a_{cj}\\,\\pi_j-\\frac{g_c^\\circ}{RT}\\Big)\\;\\le 1,\\qquad a_c=1\\ \\text{when the phase is present}\n\\end{equation}\n\\begin{equation}\n\\text{absent gas or slag phase }p:\\qquad Q_p=\\sum_{i\\in p}\\exp\\!\\Big(\\sum_j a_{ij}\\,\\pi_j-\\frac{g_i^\\circ}{RT}-c_i\\Big)\\le 1,\\qquad c_i=\\begin{cases}\\ln(P/P^\\circ) & \\text{gas}\\\\[2pt] \\ln\\gamma_i & \\text{slag}\\end{cases}\n\\end{equation}\n\\begin{equation}\np_i=P^\\circ\\exp\\!\\Big(\\sum_j a_{ij}\\,\\pi_j-\\frac{g_i^\\circ}{RT}\\Big),\\qquad\\text{for example}\\quad p_{\\mathrm{O_2}}=P^\\circ\\exp\\!\\Big(2\\,\\pi_\\mathrm{O}-\\frac{g^\\circ_{\\mathrm{O_2}}}{RT}\\Big)\n\\end{equation}\n\\begin{equation}\nG_{\\min}=RT\\sum_j \\pi_j\\,b_j\n\\end{equation}\n\\begin{equation}\n\\text{saturation checks outside the minimisation:}\\qquad a_\\mathrm{CaS}=\\exp\\!\\Big(\\pi_\\mathrm{Ca}+\\pi_\\mathrm{S}-\\frac{g^\\circ_\\mathrm{CaS}}{RT}\\Big),\\qquad a_{\\mathrm{Zn(l)}}=\\exp\\!\\Big(\\pi_\\mathrm{Zn}-\\frac{g^\\circ_{\\mathrm{Zn(l)}}}{RT}\\Big)\n\\end{equation}\n\n% Slag activity coefficients\n\\begin{equation}\ng_i^{\\mathrm E}=RT\\ln\\gamma_i=h_i^{\\mathrm E}-T\\,s_i^{\\mathrm E},\\qquad h_i^{\\mathrm E}=R\\,\\frac{\\partial\\ln\\gamma_i}{\\partial(1/T)},\\qquad H_\\mathrm{slag}=\\sum_i n_i\\big(h_i^\\circ+h_i^{\\mathrm E}\\big)\n\\end{equation}\n\\begin{equation}\n\\text{constant:}\\qquad \\ln\\gamma_i=\\ln\\gamma_i^{\\ast},\\qquad h_i^{\\mathrm E}=0,\\qquad s_i^{\\mathrm E}=-R\\ln\\gamma_i^{\\ast}\n\\end{equation}\n\\begin{equation}\n\\text{regular solution:}\\qquad \\ln\\gamma_i=\\ln\\gamma_i^{\\ast}\\,\\frac{T_\\mathrm{ref}}{T},\\qquad h_i^{\\mathrm E}=R\\,T_\\mathrm{ref}\\ln\\gamma_i^{\\ast},\\qquad s_i^{\\mathrm E}=0\n\\end{equation}\n\\begin{equation}\n\\text{table:}\\qquad \\ln\\gamma_i=\\ln\\gamma_{i,k}+m_{i,k}\\Big(\\frac1T-\\frac1{T_k}\\Big),\\qquad m_{i,k}=\\frac{\\ln\\gamma_{i,k+1}-\\ln\\gamma_{i,k}}{1/T_{k+1}-1/T_k},\\qquad h_i^{\\mathrm E}=R\\,m_{i,k}\n\\end{equation}\n\n% Newton iteration\n\\begin{equation}\n\\Delta\\ln n_i=\\Delta\\ln N_p+\\sum_j a_{ij}\\,\\pi_j-\\frac{\\mu_i}{RT}\\qquad (i\\in p)\n\\end{equation}\n\\begin{equation}\n\\sum_j\\Big(\\sum_i a_{ik}\\,a_{ij}\\,n_i\\Big)\\pi_j+\\sum_p\\Big(\\sum_{i\\in p}a_{ik}\\,n_i\\Big)\\Delta\\ln N_p+\\sum_c a_{ck}\\,\\Delta n_c = b_k-\\sum_i a_{ik}\\,n_i-\\sum_c a_{ck}\\,n_c+\\sum_i a_{ik}\\,n_i\\,\\frac{\\mu_i}{RT}\n\\end{equation}\n\\begin{equation}\n\\sum_j\\Big(\\sum_{i\\in p}a_{ij}\\,n_i\\Big)\\pi_j+\\Big(\\sum_{i\\in p}n_i-N_p\\Big)\\Delta\\ln N_p = N_p-\\sum_{i\\in p}n_i+\\sum_{i\\in p}n_i\\,\\frac{\\mu_i}{RT}\n\\end{equation}\n\\begin{equation}\n\\sum_j a_{cj}\\,\\pi_j=\\frac{g_c^\\circ}{RT}\\qquad\\text{for each pure phase present}\n\\end{equation}\n\\begin{equation}\n\\ln n_i\\leftarrow\\ln n_i+\\omega\\,\\Delta\\ln n_i,\\qquad \\ln N_p\\leftarrow\\ln N_p+\\omega\\,\\Delta\\ln N_p,\\qquad n_c\\leftarrow n_c+\\omega\\,\\Delta n_c\n\\end{equation}\n\\begin{equation}\n\\omega=\\min\\!\\Big(1,\\ \\frac{2}{\\max\\big(5\\,|\\Delta\\ln N_p|,\\ |\\Delta\\ln n_i|\\big)}\\Big)\n\\end{equation}\n\n% Standard-state functions\n\\begin{equation}\n\\frac{c_p^\\circ}{R}=a_1+a_2T+a_3T^2+a_4T^3+a_5T^4\n\\end{equation}\n\\begin{equation}\n\\frac{h^\\circ}{RT}=a_1+\\frac{a_2}{2}T+\\frac{a_3}{3}T^2+\\frac{a_4}{4}T^3+\\frac{a_5}{5}T^4+\\frac{a_6}{T}\n\\end{equation}\n\\begin{equation}\n\\frac{s^\\circ}{R}=a_1\\ln T+a_2T+\\frac{a_3}{2}T^2+\\frac{a_4}{3}T^3+\\frac{a_5}{4}T^4+a_7\n\\end{equation}\n\\begin{equation}\nh^\\circ(T)=h^\\circ(T_b)+c_p^\\circ(T_b)\\,(T-T_b),\\qquad s^\\circ(T)=s^\\circ(T_b)+c_p^\\circ(T_b)\\,\\ln\\frac{T}{T_b}\\qquad\\text{outside the fitted range}\n\\end{equation}\n\\begin{equation}\n\\text{ZnO:}\\qquad c_p^\\circ=a+bT+cT^{-2},\\qquad h^\\circ(T)=\\Delta_\\mathrm{f}H^\\circ_{298}+a\\,(T-T_0)+\\frac{b}{2}\\,(T^2-T_0^2)-c\\Big(\\frac{1}{T}-\\frac{1}{T_0}\\Big)\n\\end{equation}\n\\begin{equation}\n\\text{ZnO:}\\qquad s^\\circ(T)=S^\\circ_{298}+a\\ln\\frac{T}{T_0}+b\\,(T-T_0)-\\frac{c}{2}\\Big(\\frac{1}{T^2}-\\frac{1}{T_0^2}\\Big)\n\\end{equation}\n\\begin{equation}\ng^\\circ_{\\mathrm{FeO(l)}}=g^{\\circ,\\,\\mathrm{JANAF}}_{\\mathrm{FeO(l)}}+5829.5+3.1911\\,T\\qquad[\\mathrm{J\\,mol^{-1}}]\n\\end{equation}\n\n% External standard-state data\n\\begin{equation}\n\\text{NASA-9:}\\qquad \\frac{c_p^\\circ}{R}=\\frac{a_1}{T^2}+\\frac{a_2}{T}+a_3+a_4T+a_5T^2+a_6T^3+a_7T^4\n\\end{equation}\n\\begin{equation}\n\\frac{h^\\circ}{RT}=-\\frac{a_1}{T^2}+\\frac{a_2\\ln T}{T}+a_3+\\frac{a_4T}{2}+\\frac{a_5T^2}{3}+\\frac{a_6T^3}{4}+\\frac{a_7T^4}{5}+\\frac{b_1}{T}\n\\end{equation}\n\\begin{equation}\n\\frac{s^\\circ}{R}=-\\frac{a_1}{2T^2}-\\frac{a_2}{T}+a_3\\ln T+a_4T+\\frac{a_5T^2}{2}+\\frac{a_6T^3}{3}+\\frac{a_7T^4}{4}+b_2\n\\end{equation}\n\\begin{equation}\n\\text{Shomate:}\\qquad c_p^\\circ=A+Bt+Ct^2+Dt^3+\\frac{E}{t^2},\\qquad h^\\circ=10^3\\Big(At+\\frac{Bt^2}{2}+\\frac{Ct^3}{3}+\\frac{Dt^4}{4}-\\frac{E}{t}+F\\Big)\n\\end{equation}\n\\begin{equation}\ns^\\circ=A\\ln t+Bt+\\frac{Ct^2}{2}+\\frac{Dt^3}{3}-\\frac{E}{2t^2}+G,\\qquad t=\\frac{T}{1000\\ \\mathrm K}\n\\end{equation}\n\\begin{equation}\n\\text{Calphad:}\\qquad G(T)=\\sum_k c_k\\,T^{n_k}(\\ln T)^{m_k},\\qquad s^\\circ=-\\frac{\\mathrm dG}{\\mathrm dT},\\qquad h^\\circ=G+T\\,s^\\circ,\\qquad c_p^\\circ=-T\\,\\frac{\\mathrm d^2G}{\\mathrm dT^2}\n\\end{equation}\n\\begin{equation}\n\\text{table:}\\qquad h^\\circ(T)=H_{00}(u)\\,h_k+H_{10}(u)\\,\\Delta T\\,c_{p,k}+H_{01}(u)\\,h_{k+1}+H_{11}(u)\\,\\Delta T\\,c_{p,k+1},\\qquad u=\\frac{T-T_k}{\\Delta T}\n\\end{equation}\n\\begin{equation}\ns^\\circ(T)=H_{00}(u)\\,s_k+H_{10}(u)\\,\\Delta T\\,\\frac{c_{p,k}}{T_k}+H_{01}(u)\\,s_{k+1}+H_{11}(u)\\,\\Delta T\\,\\frac{c_{p,k+1}}{T_{k+1}}\n\\end{equation}\n\\begin{equation}\ns^\\circ(1\\,\\mathrm{bar})=s^\\circ(p_\\mathrm{ref})+R\\ln\\frac{p_\\mathrm{ref}}{1\\,\\mathrm{bar}}\n\\end{equation}\n\n% Coupling to an external activity model\n\\begin{equation}\n\\gamma_i=\\frac{1}{x_i}\\exp\\!\\Big(\\frac{\\mu_i^{\\mathrm{DB}}(T,x)-f_i\\,g_i^{\\circ,\\mathrm{DB}}(T)}{RT}\\Big),\\qquad \\mu_{\\mathrm{ZnO}}^{\\mathrm{DB}}=\\mu_\\mathrm{Zn}^{\\mathrm{DB}}+\\mu_\\mathrm{O}^{\\mathrm{DB}}\n\\end{equation}\n\\begin{equation}\n\\gamma^{(k+1)}=\\gamma\\big(x^{(k)},T^{(k)}\\big)\\qquad\\text{until}\\qquad \\max_i\\big|\\ln\\gamma_i^{(k+1)}-\\ln\\gamma_i^{(k)}\\big|<2\\times10^{-3}\n\\end{equation}\n\n% Equilibria in the bath\n\\begin{equation}\n\\Delta_\\mathrm{r}G^\\circ=\\sum_i\\nu_i\\,g_i^\\circ,\\qquad \\Delta_\\mathrm{r}H^\\circ=\\sum_i\\nu_i\\,h_i^\\circ,\\qquad K=\\exp\\!\\Big(-\\frac{\\Delta_\\mathrm{r}G^\\circ}{RT}\\Big)\n\\end{equation}\n\\begin{equation}\n\\mathrm{ZnO_{(slag)}+CO=Zn_{(g)}+CO_2}:\\qquad \\frac{p_\\mathrm{Zn}}{P^\\circ}=K_\\mathrm{Zn}\\;\\gamma_\\mathrm{ZnO}\\,x_\\mathrm{ZnO}\\;\\frac{p_\\mathrm{CO}}{p_{\\mathrm{CO_2}}}\n\\end{equation}\n\\begin{equation}\n\\mathrm{FeO_{(slag)}+CO=Fe+CO_2}:\\qquad a_\\mathrm{Fe}=K_\\mathrm{Fe}\\;\\gamma_\\mathrm{FeO}\\,x_\\mathrm{FeO}\\;\\frac{p_\\mathrm{CO}}{p_{\\mathrm{CO_2}}}\n\\end{equation}\n\\begin{equation}\n\\mathrm{FeO+\\tfrac14\\,O_2=FeO_{1.5}}:\\qquad \\frac{x_{\\mathrm{FeO_{1.5}}}}{x_\\mathrm{FeO}}=K_\\mathrm{ox}\\;\\frac{\\gamma_\\mathrm{FeO}}{\\gamma_{\\mathrm{FeO_{1.5}}}}\\;\\Big(\\frac{p_{\\mathrm{O_2}}}{P^\\circ}\\Big)^{1/4}\n\\end{equation}\n\\begin{equation}\n\\mathrm{3\\,ZnO+2\\,Al=3\\,Zn_{(g)}+Al_2O_3}:\\qquad m_\\mathrm{Zn}^{\\max}=\\frac{3\\,M_\\mathrm{Zn}}{2\\,M_\\mathrm{Al}}\\;m_\\mathrm{Al}=3.63\\;m_\\mathrm{Al}\n\\end{equation}\n\n% Feeds\n\\begin{equation}\nn_\\mathrm{ZnO}=\\frac{10\\,w_\\mathrm{Zn}}{M_\\mathrm{Zn}},\\qquad n_\\mathrm{FeO}=\\frac{10\\,w_\\mathrm{Fe}\\,(1-f_3)}{M_\\mathrm{Fe}},\\qquad n_{\\mathrm{FeO_{1.5}}}=\\frac{10\\,w_\\mathrm{Fe}\\,f_3}{M_\\mathrm{Fe}},\\qquad n_{\\mathrm{AlO_{1.5}}}=\\frac{20\\,w_{\\mathrm{Al_2O_3}}}{M_{\\mathrm{Al_2O_3}}}\\qquad[\\mathrm{mol\\,kg^{-1}}]\n\\end{equation}\n\\begin{equation}\nH_\\mathrm{coal}(T_0)=m_\\mathrm{d}\\Big[\\mathrm{HHV}+\\frac{w_\\mathrm{C}}{M_\\mathrm{C}}\\,h^\\circ_{\\mathrm{CO_2}}+\\frac{w_\\mathrm{H}}{2M_\\mathrm{H}}\\,h^\\circ_{\\mathrm{H_2O(l)}}+\\frac{w_\\mathrm{S}}{M_\\mathrm{S}}\\,h^\\circ_{\\mathrm{SO_2}}\\Big]+n_\\mathrm{w}\\,h^\\circ_{\\mathrm{H_2O(l)}}+H_\\mathrm{ash}(T_0)\n\\end{equation}\n\\begin{equation}\n\\mathrm{HHV}=0.3491\\,C+1.1783\\,H+0.1005\\,S-0.1034\\,O-0.0151\\,N-0.0211\\,A\\qquad[\\mathrm{MJ\\,kg^{-1}}]\n\\end{equation}\n\\begin{equation}\n\\dot n_{\\mathrm{O_2}}=x_{\\mathrm{O_2}}\\,\\dot V_\\mathrm{n}\\,\\frac{P_\\mathrm{n}}{R\\,T_\\mathrm{n}},\\qquad \\dot n_{\\mathrm{N_2}}=(1-x_{\\mathrm{O_2}})\\,\\dot V_\\mathrm{n}\\,\\frac{P_\\mathrm{n}}{R\\,T_\\mathrm{n}},\\qquad \\frac{P_\\mathrm{n}}{R\\,T_\\mathrm{n}}=44.62\\ \\mathrm{mol\\,Nm^{-3}}\n\\end{equation}\n\\begin{equation}\n\\dot n_\\mathrm{Al}=\\frac{f_\\mathrm{m}\\,\\dot m_\\mathrm{Al}}{M_\\mathrm{Al}},\\qquad \\dot n_{\\mathrm{AlO_{1.5}}}=\\frac{2\\,(1-f_\\mathrm{m})\\,\\dot m_\\mathrm{Al}}{M_{\\mathrm{Al_2O_3}}}\n\\end{equation}\n\n% Heat balance\n\\begin{equation}\nH=\\sum_i n_i\\big(h_i^\\circ(T)+h_i^{\\mathrm E}(T)\\big),\\qquad H^{\\mathrm{E}}=-T^2\\,\\frac{\\partial}{\\partial T}\\Big(\\frac{G^{\\mathrm{E}}}{T}\\Big)=\\sum_i n_i\\,h_i^{\\mathrm E}\\quad\\text{for}\\quad G^{\\mathrm{E}}=RT\\sum_i n_i\\ln\\gamma_i(T)\n\\end{equation}\n\\begin{equation}\n\\sum_k H_k(T_k)=H_\\mathrm{slag}(T)+H_\\mathrm{gas}(T)+H_\\mathrm{cond}(T)+Q_\\mathrm{loss}+Q_\\mathrm{net}\n\\end{equation}\n\\begin{equation}\nf(T)=H_\\mathrm{slag}(T)+H_\\mathrm{gas}(T)+H_\\mathrm{cond}(T)+Q_\\mathrm{loss}-\\sum_k H_k(T_k)=0\n\\end{equation}\n\\begin{equation}\nQ_\\mathrm{net}=\\underbrace{\\sum_k\\big[H_k(T_k)-H_k(T_0)\\big]}_{\\text{sensible heat of feeds}}+\\underbrace{\\sum_g Q_g+Q_\\mathrm{melt}}_{\\text{chemical heat}}-\\underbrace{\\sum_{\\text{products}}n_i\\big[h_i^\\circ(T)-h_i^\\circ(T_0)\\big]}_{\\text{sensible heat of products}}-Q_\\mathrm{loss}\n\\end{equation}\n\\begin{equation}\nQ_g=\\sum_{i\\in g}^{\\text{feeds}}n_i\\,h_i^\\circ(T_0)-\\sum_{i\\in g}^{\\text{products}}n_i\\,h_i^\\circ(T_0)\n\\end{equation}\n\\begin{equation}\nQ_\\mathrm{melt}=\\sum_i\\big(n_i^{\\mathrm{cold}}+n_i^{\\mathrm{ash}}\\big)\\big[h_i^{\\mathrm{cryst}}(T_0)-h_i^{\\mathrm{slag}}(T_0)\\big]\n\\end{equation}\n\n% Batch cycle\n\\begin{equation}\nb_j^{(k)}=\\sum_i a_{ij}\\,n_i^{\\mathrm{bath},(k-1)}+\\Delta t\\sum_f \\dot b_{j,f}\n\\end{equation}\n\\begin{equation}\nH_\\mathrm{bath}^{(k-1)}+\\Delta t\\sum_f \\dot H_f=H_\\mathrm{bath}^{(k)}(T_k)+H_\\mathrm{gas}^{(k)}(T_k)+\\dot Q_\\mathrm{loss}\\,\\Delta t\n\\end{equation}\n\\begin{equation}\nR_\\mathrm{Zn}=\\frac{\\sum_k n_{\\mathrm{Zn(g)}}^{(k)}}{n_\\mathrm{Zn}^{\\mathrm{feed}}},\\qquad m_{\\mathrm{CO_2}}=n_\\mathrm{C}^{\\mathrm{coal}}\\,M_{\\mathrm{CO_2}}\n\\end{equation}\n\n% Two-zone option\n\\begin{equation}\nQ_\\mathrm{pc}=H_\\mathrm{gas}^{\\mathrm{A}}(T)+\\varphi\\,H_\\mathrm{blast}-H_\\mathrm{gas}^{\\mathrm{B}}(T)\n\\end{equation}\n\\begin{equation}\n\\sum_{k\\neq\\text{blast}}H_k(T_k)+(1-\\varphi)\\,H_\\mathrm{blast}+\\eta\\,Q_\\mathrm{pc}=H_\\mathrm{slag}(T)+H_\\mathrm{cond}(T)+H_\\mathrm{gas}^{\\mathrm{A}}(T)+Q_\\mathrm{loss}\n\\end{equation}\n"